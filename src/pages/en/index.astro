---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Soluciones from '../../components/Soluciones.astro';
import ParaQuien from '../../components/ParaQuien.astro';
import Casos from '../../components/Casos.astro';
import ComoTrabajamos from '../../components/ComoTrabajamos.astro';
import CTA from '../../components/CTA.astro';
import Contacto from '../../components/Contacto.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { useT } from '../../i18n/index';

const lang = 'en';
const t = useT(lang);
---

<Base title={t.seo.title} description={t.seo.description} lang={lang}>
  <Header lang={lang} />
  <Hero lang={lang} />
  <Soluciones lang={lang} />
  <ParaQuien lang={lang} />
  <Casos lang={lang} />
  <ComoTrabajamos lang={lang} />
  <CTA lang={lang} />
  <Contacto lang={lang} />
  <Footer lang={lang} />
  <WhatsAppButton lang={lang} />
</Base>
