---
interface Props {
  animated?: boolean;
  priority?: boolean;
  as?: 'div' | 'section';
  id?: string;
  class?: string;
}

const {
  animated = false,
  priority = false,
  as: Tag = 'div',
  id,
  class: className = '',
} = Astro.props;
---

<Tag
  id={id}
  class:list={['tech-bg relative overflow-hidden bg-navy', animated && 'tech-bg--animated', className]}
  data-tech-bg-animated={animated ? '' : undefined}
>
  <!-- Capa 1: Imagen de fondo -->
  <picture class="pointer-events-none absolute inset-0 z-0 h-full w-full overflow-hidden">
    <source media="(max-width: 767px)" srcset="/img/hero-bg-mobile.webp" />
    <img
      src="/img/hero-bg.webp"
      alt=""
      aria-hidden="true"
      width="1920"
      height="1080"
      fetchpriority={priority ? 'high' : undefined}
      loading={priority ? 'eager' : 'lazy'}
      class:list={[
        'h-full w-full object-cover object-center',
        animated && 'tech-bg-img',
      ]}
    />
  </picture>

  <!-- Capa 2: Azul marino semitransparente -->
  <div
    class="pointer-events-none absolute inset-0 z-10"
    style="background: linear-gradient(to right, rgba(11, 42, 91, 0.92), rgba(11, 42, 91, 0.70));"
  ></div>

  <!-- Capa 3: Animación de circuitos (solo si animated=true) -->
  {animated && (
    <div class="pointer-events-none absolute inset-0 z-10 overflow-hidden" aria-hidden="true">
      <!-- Circuitos móvil (< 768px): máx. 3 trazos -->
      <svg
        class="h-full w-full md:hidden"
        viewBox="0 0 375 750"
        preserveAspectRatio="xMidYMid slice"
        fill="none"
      >
        <!-- Trazo M1: Teal -->
        <path d="M 375 60 L 290 60 L 290 140 L 230 140" stroke="#1A9A92" stroke-width="1" stroke-opacity="0.12" />
        <path d="M 375 60 L 290 60 L 290 140 L 230 140" pathLength="100" stroke="#1A9A92" stroke-width="2" stroke-linecap="round" class="circuit-pulse pulse-teal pulse-m1" />
        <circle cx="230" cy="140" r="3" fill="#1A9A92" class="circuit-node node-1" />
        <circle cx="290" cy="60" r="2.5" fill="#1A9A92" class="circuit-node node-2" />

        <!-- Trazo M2: Verde -->
        <path d="M 0 50 L 75 50 L 75 110 L 125 110" stroke="#3AA57A" stroke-width="1" stroke-opacity="0.12" />
        <path d="M 0 50 L 75 50 L 75 110 L 125 110" pathLength="100" stroke="#3AA57A" stroke-width="2" stroke-linecap="round" class="circuit-pulse pulse-green pulse-m2" />
        <circle cx="125" cy="110" r="3" fill="#3AA57A" class="circuit-node node-3" />
        <circle cx="75" cy="50" r="2.5" fill="#3AA57A" class="circuit-node node-4" />

        <!-- Trazo M3: Naranja -->
        <path d="M 375 610 L 300 610 L 300 560 L 260 560" stroke="#C0652B" stroke-width="1" stroke-opacity="0.15" />
        <path d="M 375 610 L 300 610 L 300 560 L 260 560" pathLength="100" stroke="#C0652B" stroke-width="2" stroke-linecap="round" class="circuit-pulse pulse-orange pulse-m3" />
        <circle cx="260" cy="560" r="3" fill="#C0652B" class="circuit-node node-5" />
      </svg>

      <!-- Circuitos desktop (>= 768px): 5 trazos, mitad derecha y bordes -->
      <svg
        class="hidden h-full w-full md:block"
        viewBox="0 0 1440 850"
        preserveAspectRatio="xMidYMid slice"
        fill="none"
      >
        <!-- Trazo D1: Teal (esquina superior derecha) -->
        <path d="M 1440 90 L 1200 90 L 1200 190 L 1060 190" stroke="#1A9A92" stroke-width="1" stroke-opacity="0.12" />
        <path d="M 1440 90 L 1200 90 L 1200 190 L 1060 190" pathLength="100" stroke="#1A9A92" stroke-width="2" stroke-linecap="round" class="circuit-pulse pulse-teal pulse-d1" />
        <circle cx="1060" cy="190" r="3.5" fill="#1A9A92" class="circuit-node node-1" />
        <circle cx="1200" cy="90" r="3" fill="#1A9A92" class="circuit-node node-2" />

        <!-- Trazo D2: Verde (medio-derecha / inferior) -->
        <path d="M 1440 360 L 1280 360 L 1280 490 L 1140 490 L 1140 620 L 1020 620" stroke="#3AA57A" stroke-width="1" stroke-opacity="0.12" />
        <path d="M 1440 360 L 1280 360 L 1280 490 L 1140 490 L 1140 620 L 1020 620" pathLength="100" stroke="#3AA57A" stroke-width="2" stroke-linecap="round" class="circuit-pulse pulse-green pulse-d2" />
        <circle cx="1020" cy="620" r="3.5" fill="#3AA57A" class="circuit-node node-3" />
        <circle cx="1280" cy="360" r="3" fill="#3AA57A" class="circuit-node node-4" />

        <!-- Trazo D3: Naranja (arriba a la derecha del logo) -->
        <path d="M 850 60 L 980 60 L 980 140 L 1080 140" stroke="#C0652B" stroke-width="1" stroke-opacity="0.15" />
        <path d="M 850 60 L 980 60 L 980 140 L 1080 140" pathLength="100" stroke="#C0652B" stroke-width="2" stroke-linecap="round" class="circuit-pulse pulse-orange pulse-d3" />
        <circle cx="850" cy="60" r="3" fill="#C0652B" class="circuit-node node-5" />
        <circle cx="1080" cy="140" r="3.5" fill="#C0652B" class="circuit-node node-6" />

        <!-- Trazo D4: Teal (borde inferior derecho) -->
        <path d="M 1440 680 L 1260 680 L 1260 590 L 1180 590" stroke="#1A9A92" stroke-width="1" stroke-opacity="0.12" />
        <path d="M 1440 680 L 1260 680 L 1260 590 L 1180 590" pathLength="100" stroke="#1A9A92" stroke-width="2" stroke-linecap="round" class="circuit-pulse pulse-teal pulse-d4" />
        <circle cx="1180" cy="590" r="3.5" fill="#1A9A92" class="circuit-node node-7" />
        <circle cx="1260" cy="680" r="3" fill="#1A9A92" class="circuit-node node-8" />

        <!-- Trazo D5: Verde (borde superior izquierdo lejano al texto) -->
        <path d="M 60 40 L 200 40 L 200 85 L 320 85" stroke="#3AA57A" stroke-width="1" stroke-opacity="0.12" />
        <path d="M 60 40 L 200 40 L 200 85 L 320 85" pathLength="100" stroke="#3AA57A" stroke-width="2" stroke-linecap="round" class="circuit-pulse pulse-green pulse-d5" />
        <circle cx="60" cy="40" r="3" fill="#3AA57A" class="circuit-node node-9" />
        <circle cx="320" cy="85" r="3.5" fill="#3AA57A" class="circuit-node node-10" />
      </svg>
    </div>
  )}

  <!-- Capa 4: Contenido -->
  <div class="relative z-20">
    <slot />
  </div>
</Tag>

{animated && (
  <script>
    const animatedBg = document.querySelector('[data-tech-bg-animated]');
    if ('IntersectionObserver' in window && animatedBg) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animatedBg.classList.remove('is-paused');
            } else {
              animatedBg.classList.add('is-paused');
            }
          });
        },
        { threshold: 0.05 }
      );
      observer.observe(animatedBg);
    }
  </script>
)}

<style>
  /* ── 1. Movimiento lento de la imagen (solo desktop) ── */
  @keyframes slowZoom {
    0% {
      transform: scale(1) translate3d(0, 0, 0);
    }
    100% {
      transform: scale(1.06) translate3d(-1%, -0.5%, 0);
    }
  }

  @media (min-width: 768px) {
    .tech-bg--animated .tech-bg-img {
      animation: slowZoom 35s ease-in-out infinite alternate;
      transform-origin: center center;
      will-change: transform;
    }
  }

  /* ── 2. Pulsos de luz en circuitos ── */
  @keyframes pulseTravel {
    0% {
      stroke-dashoffset: 20;
    }
    100% {
      stroke-dashoffset: -100;
    }
  }

  .circuit-pulse {
    stroke-dasharray: 20 100;
    stroke-dashoffset: 20;
    opacity: 0.6;
  }

  .pulse-teal {
    filter: drop-shadow(0 0 3px rgba(26, 154, 146, 0.7));
  }
  .pulse-green {
    filter: drop-shadow(0 0 3px rgba(58, 165, 122, 0.7));
  }
  .pulse-orange {
    filter: drop-shadow(0 0 3px rgba(192, 101, 43, 0.7));
  }

  /* Duraciones y retrasos desfasados (desktop) */
  .pulse-d1 { animation: pulseTravel 5.5s linear infinite; animation-delay: 0s; }
  .pulse-d2 { animation: pulseTravel 7.2s linear infinite; animation-delay: 1.8s; }
  .pulse-d3 { animation: pulseTravel 6.0s linear infinite; animation-delay: 3.5s; }
  .pulse-d4 { animation: pulseTravel 8.0s linear infinite; animation-delay: 0.8s; }
  .pulse-d5 { animation: pulseTravel 6.5s linear infinite; animation-delay: 2.4s; }

  /* Duraciones y retrasos desfasados (móvil) */
  .pulse-m1 { animation: pulseTravel 5.5s linear infinite; animation-delay: 0s; }
  .pulse-m2 { animation: pulseTravel 6.8s linear infinite; animation-delay: 1.5s; }
  .pulse-m3 { animation: pulseTravel 6.0s linear infinite; animation-delay: 3.0s; }

  /* ── 3. Nodos que respiran ── */
  @keyframes nodeBreathe {
    0%, 100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.3);
    }
  }

  .circuit-node {
    transform-box: fill-box;
    transform-origin: center;
    animation: nodeBreathe 4s ease-in-out infinite;
  }

  .node-1  { animation-duration: 3.4s; animation-delay: 0s; }
  .node-2  { animation-duration: 4.1s; animation-delay: 0.8s; }
  .node-3  { animation-duration: 3.7s; animation-delay: 1.6s; }
  .node-4  { animation-duration: 4.5s; animation-delay: 2.3s; }
  .node-5  { animation-duration: 3.2s; animation-delay: 1.1s; }
  .node-6  { animation-duration: 4.8s; animation-delay: 0.4s; }
  .node-7  { animation-duration: 3.6s; animation-delay: 2.8s; }
  .node-8  { animation-duration: 4.2s; animation-delay: 1.9s; }
  .node-9  { animation-duration: 3.9s; animation-delay: 0.6s; }
  .node-10 { animation-duration: 4.4s; animation-delay: 2.1s; }

  /* ── 4. Pausar cuando sale de pantalla (IntersectionObserver) ── */
  .tech-bg.is-paused .tech-bg-img,
  .tech-bg.is-paused .circuit-pulse,
  .tech-bg.is-paused .circuit-node {
    animation-play-state: paused !important;
  }

  /* ── 5. Accesibilidad: prefers-reduced-motion ── */
  @media (prefers-reduced-motion: reduce) {
    .tech-bg-img,
    .circuit-pulse,
    .circuit-node {
      animation: none !important;
      transform: none !important;
      stroke-dashoffset: 0 !important;
      opacity: 0.4 !important;
    }
  }
</style>
