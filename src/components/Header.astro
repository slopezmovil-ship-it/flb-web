---
import { useT } from '../i18n/index';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useT(lang);
const alternateLang = lang === 'es' ? 'en' : 'es';
const alternateHref = lang === 'es' ? '/en/' : '/';

const navLinks = [
  { label: t.menu.servicios, href: '#servicios' },
  { label: t.menu.casos, href: '#casos' },
  { label: t.menu.comoTrabajamos, href: '#como-trabajamos' },
  { label: t.menu.contacto, href: '#contacto' },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 z-50 w-full bg-white/95 backdrop-blur-sm transition-shadow duration-300"
>
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 lg:px-8" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
    <!-- Logo -->
    <a href="#inicio" class="flex items-center gap-2" aria-label="FLB Group">
      <img
        src="/brand/flb-simbolo-3d-256.webp"
        alt="FLB Group"
        width="40"
        height="40"
        class="h-10 w-10"
      />
      <span class="text-lg text-navy">
        <span class="font-bold">FLB</span><span class="font-medium"> Group</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-8 lg:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-ink transition-colors hover:text-navy"
        >
          {link.label}
        </a>
      ))}

      <!-- Language switcher -->
      <a
        href={alternateHref}
        class="ml-2 rounded-md border border-navy/20 px-3 py-1 text-sm font-semibold text-navy transition-colors hover:bg-navy hover:text-white"
      >
        {lang === 'es' ? 'EN' : 'ES'}
      </a>
    </div>

    <!-- Mobile hamburger button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="relative flex h-10 w-10 items-center justify-center rounded-md text-navy lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'}
    >
      <!-- Hamburger icon -->
      <svg id="icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <!-- Close icon -->
      <svg id="icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-navy/10 bg-white lg:hidden"
    role="region"
    aria-label={lang === 'es' ? 'Menú móvil' : 'Mobile menu'}
  >
    <div class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link rounded-lg px-4 py-3 text-base font-medium text-ink transition-colors hover:bg-mist hover:text-navy"
        >
          {link.label}
        </a>
      ))}

      <div class="mt-2 border-t border-navy/10 pt-3">
        <a
          href={alternateHref}
          class="inline-block rounded-md border border-navy/20 px-4 py-2 text-sm font-semibold text-navy transition-colors hover:bg-navy hover:text-white"
        >
          {lang === 'es' ? 'English' : 'Español'}
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Spacer so content isn't hidden behind fixed header -->
<div class="h-16"></div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  // Close menu when clicking a nav link
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      btn?.setAttribute('aria-expanded', 'false');
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });

  // Add shadow on scroll
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      header?.classList.add('shadow-md');
    } else {
      header?.classList.remove('shadow-md');
    }
  });
</script>
