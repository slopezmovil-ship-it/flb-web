---
import { useT } from '../i18n/index';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useT(lang);
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const hasKey = web3formsKey.length > 0;
const linkedinUrl = 'https://www.linkedin.com/in/steven-l%C3%B3pez-755245247';
---

<section id="contacto" class="bg-navy py-20 text-white md:py-28">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <!-- Section heading -->
    <h2 class="mb-4 text-center text-3xl font-bold md:text-4xl">{t.contacto.titulo}</h2>
    <p class="mx-auto mb-14 max-w-2xl text-center text-base leading-relaxed text-white/80 md:text-lg">
      {t.contacto.texto}
    </p>

    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Left: contact info -->
      <div class="flex flex-col gap-8">
        <!-- WhatsApp -->
        <a
          href="https://wa.me/50689917668"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-start gap-4 transition-opacity hover:opacity-80"
        >
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-green/20 text-green">
            <!-- WhatsApp icon -->
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </span>
          <span>
            <span class="block text-sm font-medium uppercase tracking-wider text-white/60">{t.contacto.etiquetas.whatsapp}</span>
            <span class="text-base font-semibold text-white">{t.contacto.whatsapp}</span>
          </span>
        </a>

        <!-- Email -->
        <a
          href={`mailto:${t.contacto.correo}`}
          class="group flex items-start gap-4 transition-opacity hover:opacity-80"
        >
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-orange/20 text-orange">
            <!-- Mail icon -->
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
          </span>
          <span>
            <span class="block text-sm font-medium uppercase tracking-wider text-white/60">{t.contacto.etiquetas.correo}</span>
            <span class="text-base font-semibold text-white">{t.contacto.correo}</span>
          </span>
        </a>

        <!-- LinkedIn -->
        <a
          href={linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-start gap-4 transition-opacity hover:opacity-80"
        >
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-teal/20 text-teal">
            <!-- LinkedIn icon -->
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </span>
          <span>
            <span class="block text-sm font-medium uppercase tracking-wider text-white/60">{t.contacto.etiquetas.linkedin}</span>
            <span class="text-base font-semibold text-white">{t.contacto.linkedin}</span>
          </span>
        </a>

        <!-- Location -->
        <div class="flex items-start gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white/10 text-white/70">
            <!-- Map-pin icon -->
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
          </span>
          <span>
            <span class="block text-sm font-medium uppercase tracking-wider text-white/60">{t.contacto.etiquetas.ubicacion}</span>
            <span class="text-base font-semibold text-white">{t.contacto.ubicacion}</span>
          </span>
        </div>
      </div>

      <!-- Right: form -->
      <div>
        {hasKey ? (
          <form
            id="contact-form"
            class="flex flex-col gap-5 rounded-2xl bg-white/10 p-6 backdrop-blur-sm md:p-8"
            novalidate
          >
            {/* Web3Forms access key */}
            <input type="hidden" name="access_key" value={web3formsKey} />
            {/* Honeypot */}
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

            {/* Name */}
            <div>
              <label for="contact-name" class="mb-1 block text-sm font-medium text-white/80">{t.contacto.formulario.nombre}</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                class="w-full rounded-lg border border-white/20 bg-white/5 px-4 py-3 text-white placeholder-white/40 outline-none transition-colors focus:border-green focus:ring-1 focus:ring-green"
              />
            </div>

            {/* Company */}
            <div>
              <label for="contact-company" class="mb-1 block text-sm font-medium text-white/80">{t.contacto.formulario.empresa}</label>
              <input
                type="text"
                id="contact-company"
                name="company"
                required
                class="w-full rounded-lg border border-white/20 bg-white/5 px-4 py-3 text-white placeholder-white/40 outline-none transition-colors focus:border-green focus:ring-1 focus:ring-green"
              />
            </div>

            {/* Email */}
            <div>
              <label for="contact-email" class="mb-1 block text-sm font-medium text-white/80">{t.contacto.formulario.correo}</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                class="w-full rounded-lg border border-white/20 bg-white/5 px-4 py-3 text-white placeholder-white/40 outline-none transition-colors focus:border-green focus:ring-1 focus:ring-green"
              />
            </div>

            {/* Phone (optional) */}
            <div>
              <label for="contact-phone" class="mb-1 block text-sm font-medium text-white/80">{t.contacto.formulario.telefono}</label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                class="w-full rounded-lg border border-white/20 bg-white/5 px-4 py-3 text-white placeholder-white/40 outline-none transition-colors focus:border-green focus:ring-1 focus:ring-green"
              />
            </div>

            {/* Message */}
            <div>
              <label for="contact-message" class="mb-1 block text-sm font-medium text-white/80">{t.contacto.formulario.mensaje}</label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                required
                class="w-full resize-none rounded-lg border border-white/20 bg-white/5 px-4 py-3 text-white placeholder-white/40 outline-none transition-colors focus:border-green focus:ring-1 focus:ring-green"
              ></textarea>
            </div>

            {/* Submit */}
            <button
              type="submit"
              id="contact-submit"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-green px-6 py-3 text-base font-semibold text-white shadow-lg transition-all hover:bg-green-700 hover:shadow-xl disabled:cursor-not-allowed disabled:opacity-60"
            >
              {t.contacto.formulario.enviar}
            </button>

            {/* Status messages */}
            <p id="contact-success" class="hidden rounded-lg bg-green/20 px-4 py-3 text-sm font-medium text-green" role="status"></p>
            <p id="contact-error" class="hidden rounded-lg bg-red-500/20 px-4 py-3 text-sm font-medium text-red-300" role="alert"></p>
          </form>
        ) : (
          <div class="flex flex-col items-center gap-6 rounded-2xl bg-white/10 p-8 text-center backdrop-blur-sm">
            <p class="text-base text-white/80">{t.contacto.sinClave}</p>
            <a
              href="https://wa.me/50689917668"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg bg-green px-6 py-3 text-base font-semibold text-white shadow-lg transition-all hover:bg-green-700 hover:shadow-xl"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              WhatsApp
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<script define:vars={{ confirmacion: t.contacto.confirmacion, errorMsg: t.contacto.error, enviando: t.contacto.formulario.enviando, enviar: t.contacto.formulario.enviar }}>
  const form = document.getElementById('contact-form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const btn = document.getElementById('contact-submit');
      const successEl = document.getElementById('contact-success');
      const errorEl = document.getElementById('contact-error');

      // Reset status
      successEl?.classList.add('hidden');
      errorEl?.classList.add('hidden');

      // Disable button, show sending state
      if (btn) {
        btn.disabled = true;
        btn.textContent = enviando;
      }

      try {
        const formData = new FormData(form);
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
        });

        const data = await res.json();

        if (data.success) {
          if (successEl) {
            successEl.textContent = confirmacion;
            successEl.classList.remove('hidden');
          }
          form.reset();
        } else {
          throw new Error('Submit failed');
        }
      } catch {
        if (errorEl) {
          errorEl.textContent = errorMsg;
          errorEl.classList.remove('hidden');
        }
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = enviar;
        }
      }
    });
  }
</script>
