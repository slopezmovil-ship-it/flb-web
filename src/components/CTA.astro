---
import { useT } from '../i18n/index';

interface Props { lang: string; }
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="bg-gradient-to-br from-orange-700 to-orange py-16 md:py-20">
  <div class="mx-auto max-w-4xl px-4 text-center lg:px-8">
    <h2 class="mb-4 text-2xl font-bold text-white md:text-4xl">{t.cta.titulo}</h2>
    <p class="mx-auto mb-8 max-w-2xl text-base text-white/90 md:text-lg">{t.cta.texto}</p>
    <a
      href="https://wa.me/50689917668"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 whitespace-nowrap rounded-lg bg-white px-7 py-3.5 text-base font-semibold text-navy shadow-lg transition-all hover:bg-mist hover:shadow-xl"
    >
      <svg class="h-5 w-5 text-green-700" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 004.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.8 14.09c-.24.68-1.42 1.31-1.96 1.39-.5.08-1.14.11-1.83-.12-.42-.13-.96-.31-1.66-.61-2.92-1.26-4.83-4.2-4.98-4.4-.14-.19-1.19-1.58-1.19-3.02 0-1.43.75-2.14 1.02-2.43.26-.29.58-.36.77-.36l.55.01c.18.01.41-.07.65.49.24.58.82 2.01.89 2.16.07.14.12.31.02.5-.1.19-.14.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.3-.13.59.17.29.74 1.22 1.59 1.97 1.09.97 2.01 1.27 2.3 1.41.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.65-.14.26.1 1.67.79 1.96.93.29.14.48.22.55.34.07.12.07.7-.17 1.38z"/></svg>
      {t.cta.boton}
    </a>
  </div>
</section>
